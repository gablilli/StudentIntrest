{
    "name": "studentintrest",
    "version": "2.0.0",
    "description": "StudentIntrest - Complete ClasseViva client with grades, agenda, noticeboard, didactics, notes, absences, and Google Calendar sync",
    "scripts": {
        "dev:web": "cd web && python3 -m http.server 8080",
        "dev:proxy": "cd proxy && wrangler dev",
        "dev:proxy-node": "cd proxy && npm install && npm run dev",
        "deploy:proxy": "cd proxy && wrangler deploy",
        "build:extension": "npm run copy:extension",
        "copy:extension": "cp -r shared/* browser-extension/ && echo 'Extension files updated'",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "docker:build": "docker compose up -d --build",
        "lint": "echo 'No linting configured yet'",
        "test": "echo 'No tests configured yet'"
    },
    "keywords": [
        "classeviva",
        "grades",
        "calculator",
        "spaggiari",
        "browser-extension",
        "ios",
        "pwa",
        "agenda",
        "noticeboard",
        "didactics",
        "calendar-sync",
        "google-calendar"
    ],
    "author": "StudentIntrest Contributors",
    "license": "MIT",
    "devDependencies": {
        "wrangler": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gablilli/StudentIntrest"
    }
}